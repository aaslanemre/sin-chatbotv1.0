# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant - different port and collection from v2.1
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sin_docs

# RAG - tuned values
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.45

# Paths
INCOMING_DOCS_DIR=docs/incoming
PROCESSED_DOCS_DIR=docs/processed
MODIFIED_PWF_DIR=modified_pwf
RESULTS_DIR=results
MEMORY_STORE_PATH=memory_store/last_study_v3.json

# n8n - different port from v2.1
N8N_PORT=5680
N8N_WEBHOOK_URL=http://localhost:5680/webhook/ingest-pdf

# Ingest API - different port from v2.1
INGEST_API_PORT=8002
