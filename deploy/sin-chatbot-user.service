[Unit]
Description=SIN Chatbot - User App (port 8501, public)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=siemens
WorkingDirectory=/home/siemens/sin-chatbot
Environment="PATH=/home/siemens/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 -m streamlit run app.py \
  --server.port 8501 \
  --server.address 0.0.0.0 \
  --server.headless true \
  --browser.gatherUsageStats false
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
