[Unit]
Description=SIN Chatbot - Admin App (port 8503, localhost only)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=siemens
WorkingDirectory=/home/siemens/sin-chatbotv1.0

# SECURITY: The admin app binds to 127.0.0.1 intentionally.
# It must NEVER be changed to 0.0.0.0.
# Access it via SSH tunnel:
#   ssh -L 8503:localhost:8503 siemens@<server-ip>
#   then open http://localhost:8503 in your browser.

Environment="PATH=/home/siemens/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3.11 -m streamlit run admin_app.py \
  --server.port 8503 \
  --server.address 127.0.0.1 \
  --server.headless true \
  --browser.gatherUsageStats false
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
